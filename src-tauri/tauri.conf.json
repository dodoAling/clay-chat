{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clay Chat",
  "version": "0.1.0",
  "identifier": "app.claychat.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5180",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Clay Chat", "width": 1320, "height": 880, "minWidth": 820, "minHeight": 620, "decorations": false, "center": true }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; img-src 'self' data: blob:; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "resources": ["../licenses/open-claude-ui-LICENSE"],
    "windows": { "nsis": { "displayLanguageSelector": false, "languages": ["SimpChinese", "English"], "installMode": "currentUser" } }
  }
}
