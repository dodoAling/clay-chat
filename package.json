{
  "name": "clay-chat",
  "productName": "Clay Chat",
  "version": "0.1.0",
  "private": true,
  "description": "A calm AI workspace for the web and desktop, built with Open Claude UI.",
  "type": "module",
  "scripts": {
    "dev": "node web/index.mjs --dev",
    "start": "node web/index.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "desktop:dev": "cd desktop && tauri dev",
    "desktop": "cd desktop && tauri dev",
    "package:web": "npm run build && node scripts/package-web.mjs",
    "package:desktop": "cd desktop && tauri build --bundles nsis",
    "build:desktop": "cd desktop && tauri build --no-bundle",
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node scripts/verify-ui.mjs",
    "test:desktop": "node scripts/verify-desktop.mjs",
    "screenshots": "node scripts/capture-readme-media.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "framer-motion": "^14.3.0",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.21",
    "playwright-core": "^1.63.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  },
  "engines": { "node": ">=22.12.0" }
}
